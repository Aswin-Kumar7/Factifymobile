<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        INTERNET is the one permission every check needs, and it has to be declared.

        This comment used to say INTERNET "is granted implicitly". It is not: it is
        a normal permission, granted automatically only when it is declared here.
        Debug and profile builds hid the mistake because Flutter's own debug and
        profile manifests declare it, so the release APK's merged manifest had no
        INTERNET line at all and an installed release build could not reach the
        server. Verified against the merged manifest on 2026-09-14.

        No storage permission is requested. Share-sheet intake receives a file the
        sender already chose, and manual selection goes through the system picker,
        which grants access to exactly one file without READ_MEDIA or
        READ_EXTERNAL_STORAGE. Asking for the whole gallery to check one image is a
        trade no verification tool has earned.

        The rest serve "Notify me when ready", and only when someone turns it on:
        POST_NOTIFICATIONS is asked for at that moment (Android 13 and later), and
        the foreground service keeps a check running while they are back in their
        chat - a data transfer that ends when the answer arrives.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="Factify"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
                Share targets. This is the primary way content arrives: the
                message being checked lives in a forward, and asking someone to
                copy it out loses most of them at that step.
            -->

            <!--
                Text and links go to QuickVerdictActivity below, which answers over
                the chat; it hands them here, as an explicit share, when the quick
                verdict is turned off in Profile.
            -->

            <!-- A single image or video, from the gallery or a chat. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- A forwarded document, typically a PDF circular or notice. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!--
                Multiple items. Accepted so the app appears in the share sheet
                when several are selected; the first is checked and the rest are
                ignored rather than silently batched, because a single verdict
                over mixed content would be a verdict about nothing in particular.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!--
                Sign-in return. Google sign-in finishes in the browser, and Supabase
                sends the person back here with their session: factify://auth-callback.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="factify" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
            The quick verdict over the chat (v5, 2.7): text and links shared from
            another app are checked in a see-through window over that app, and the
            answer shown in a sheet with "Copy correction". Its own Dart entry point
            (quickVerdictMain); left out of Recents, since it belongs to the chat.
        -->
        <activity
            android:name=".QuickVerdictActivity"
            android:exported="true"
            android:label="Factify"
            android:theme="@style/QuickVerdictTheme"
            android:excludeFromRecents="true"
            android:taskAffinity="com.factify.factify_mobile.quick"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget (v5, 2.8): three buttons that open the app. -->
        <receiver
            android:name=".FactifyWidget"
            android:exported="true"
            android:label="Factify">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/factify_widget_info" />
        </receiver>

        <!-- Keeps a check running while its answer is waited for (see above). -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening a cited source in the user's own browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
