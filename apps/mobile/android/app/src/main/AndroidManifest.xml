<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        INTERNET is the only permission, and it has to be declared.

        This comment used to say INTERNET "is granted implicitly". It is not: it is
        a normal permission, granted automatically only when it is declared here.
        Debug and profile builds hid the mistake because Flutter's own debug and
        profile manifests declare it, so the release APK's merged manifest had no
        INTERNET line at all and an installed release build could not reach the
        server. Verified against the merged manifest on 2026-09-14.

        No storage permission is requested. Share-sheet intake receives a file the
        sender already chose, and manual selection goes through the system picker,
        which grants access to exactly one file without READ_MEDIA or
        READ_EXTERNAL_STORAGE. Asking for the whole gallery to check one image is a
        trade no verification tool has earned.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Facify"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
                Share targets. This is the primary way content arrives: the
                message being checked lives in a forward, and asking someone to
                copy it out loses most of them at that step.
            -->

            <!-- Text and links, from a messaging app or a browser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- A single image or video, from the gallery or a chat. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- A forwarded document, typically a PDF circular or notice. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!--
                Multiple items. Accepted so the app appears in the share sheet
                when several are selected; the first is checked and the rest are
                ignored rather than silently batched, because a single verdict
                over mixed content would be a verdict about nothing in particular.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening a cited source in the user's own browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
