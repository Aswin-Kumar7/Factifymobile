<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Flutter draws: Factify's mark on emerald, which the
     app's own splash (lib/screens/splash_screen.dart) then continues. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/factify_emerald" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_mark" />
    </item>
</layer-list>
