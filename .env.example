# Facify configuration.
#
# Copy to .env for local development. NEVER commit a filled-in .env — the real
# values belong in the server environment only.
#
# Nesting uses a double underscore: FACIFY_VISION__API_KEY sets vision.api_key.
#
# Every provider defaults to disabled with a zero cap. That is deliberate: an
# accidental deploy must reach for nothing and cost nothing. Turning a provider on
# requires both an explicit enable and an explicit cap.

FACIFY_ENVIRONMENT=local
FACIFY_LOG_LEVEL=INFO

# Postgres with pgvector. Required outside the local environment.
# FACIFY_DATABASE_URL=postgresql://user:password@host:5432/facify

# Authenticates the scheduler to the internal ingestion endpoint (M24).
# Not a provider credential.
# FACIFY_INGEST_TRIGGER_SECRET=

# --- Model identifiers -------------------------------------------------------
# Model names live here and nowhere else in the codebase. Measure the real quota
# in the team account before setting caps below (codexplan.md §11).
# FACIFY_MODELS__EXTRACTION=
# FACIFY_MODELS__ESCALATION=
# FACIFY_MODELS__TEXT_EMBEDDING=
# FACIFY_MODELS__IMAGE_EMBEDDING=

# --- Providers ---------------------------------------------------------------
# Bounded extraction and OCR. One call per document.
# FACIFY_LLM__ENABLED=false
# FACIFY_LLM__API_KEY=
# FACIFY_LLM__DAILY_CAP=50
# FACIFY_LLM__PER_MINUTE_CAP=5

# Published fact-check lookup.
# FACIFY_FACTCHECK__ENABLED=false
# FACIFY_FACTCHECK__API_KEY=
# FACIFY_FACTCHECK__DAILY_CAP=100

# Reverse-image discovery. Free allowance is ~1,000 units/month; the cap below sits
# under that on purpose so we degrade before the provider does.
# FACIFY_VISION__ENABLED=false
# FACIFY_VISION__API_KEY=
# FACIFY_VISION__DAILY_CAP=30

# Archive capture lookup. Additive confirmation only — no gate depends on it.
# FACIFY_ARCHIVE__ENABLED=false
# FACIFY_ARCHIVE__API_KEY=
# FACIFY_ARCHIVE__DAILY_CAP=50

# --- Limits ------------------------------------------------------------------
# Enforced before any decode or parse (M10).
# FACIFY_LIMITS__MAX_UPLOAD_BYTES=26214400
# FACIFY_LIMITS__MAX_PDF_PAGES=50
# FACIFY_LIMITS__MAX_VIDEO_SECONDS=90
# FACIFY_LIMITS__MAX_VIDEO_KEYFRAMES=12
# FACIFY_LIMITS__RAW_MEDIA_RETENTION_HOURS=24
