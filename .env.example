# Factify configuration.
#
# Copy to .env for local development. NEVER commit a filled-in .env — the real
# values belong in the server environment only.
#
# Nesting uses a double underscore: FACTIFY_VISION__API_KEY sets vision.api_key.
#
# Every provider defaults to disabled with a zero cap. That is deliberate: an
# accidental deploy must reach for nothing and cost nothing. Turning a provider on
# requires both an explicit enable and an explicit cap.

FACTIFY_ENVIRONMENT=local
FACTIFY_LOG_LEVEL=INFO

# Postgres with pgvector. Required outside the local environment.
# FACTIFY_DATABASE_URL=postgresql://user:password@host:5432/factify

# Authenticates the scheduler to the internal ingestion endpoint (M24).
# Not a provider credential.
# FACTIFY_INGEST_TRIGGER_SECRET=

# How often, in seconds, the running service collects the news (a small batch of
# feeds from data/feeds.json each time). 0 turns it off - do that on Cloud Run, where
# instances scale to zero and multiply, and call /internal/ingest-tick from Cloud
# Scheduler instead.
# FACTIFY_INGESTION_INTERVAL_SECONDS=900

# Our own stored articles are searched before the paid web search. true by default.
# FACTIFY_CORPUS_RETRIEVAL=true

# Signs result receipts (M42). Not a provider credential — it signs our own
# attestations. Absent means receipts are not issued, which is safer than signing
# with a guessable default: that would verify for anyone and only look like
# tamper-evidence. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# FACTIFY_RECEIPT_SIGNING_KEY=

# --- Model identifiers -------------------------------------------------------
# Model names live here and nowhere else in the codebase. Measure the real quota
# in the team account before setting caps below (codexplan.md §11).
# Free tier as of Aug 2026 covers Flash and Flash-Lite; Pro sits behind billing.
# Confirm current ids against your key before setting these — model names move.
# FACTIFY_MODELS__EXTRACTION=gemini-3-flash
# FACTIFY_MODELS__ESCALATION=gemini-3-flash
# FACTIFY_MODELS__TEXT_EMBEDDING=
# FACTIFY_MODELS__IMAGE_EMBEDDING=

# --- Providers ---------------------------------------------------------------
# Three of these are Google, but they are three *different* Google products with
# three different consoles and billing stories. They are not interchangeable and one
# key does not necessarily cover the others.

# GOOGLE GEMINI — Generative Language API (`generateContent`).
# Key from Google AI Studio: https://aistudio.google.com/apikey
#
# This one key does two jobs. Claim extraction (M18) sends text; OCR (M19) sends the
# image itself as inlineData to the same model. There is deliberately no separate OCR
# provider — Cloud Vision's OCR would be a second vendor, a second key and a second
# quota for a job the model already does.
#
# The highest-impact key by a distance: without it /v1/verify extracts no claims and
# every response abstains with "claim extraction is not configured".
# Endpoint is configuration, not code. {model} is filled from FACTIFY_MODELS__*.
# Vertex AI (aiplatform.googleapis.com) is rejected at boot: it wants an OAuth
# bearer token from a service account, not the x-goog-api-key header this sends.
# FACTIFY_LLM__ENABLED=false
# FACTIFY_LLM__API_KEY=
# FACTIFY_LLM__ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
# FACTIFY_LLM__DAILY_CAP=50
# FACTIFY_LLM__PER_MINUTE_CAP=5

# GOOGLE FACT CHECK TOOLS API — factchecktools.googleapis.com, claims:search.
# Enable on a Google Cloud project, then create an API key. Free.
# Verified live 2026-08-16: returns 403 PERMISSION_DENIED without a key.
#
# Lowest urgency of the three. The local fact-checker corpus (Alt News, BOOM, Factly,
# Vishvas, Newschecker, Digiteye) already covers this path, which is why the M27 gate
# was written to pass with this disabled.
# FACTIFY_FACTCHECK__ENABLED=false
# FACTIFY_FACTCHECK__API_KEY=
# FACTIFY_FACTCHECK__ENDPOINT=https://factchecktools.googleapis.com/v1alpha1/claims:search
# The cap is ours, not Google's — the Fact Check Tools API costs nothing and its own
# quota is far higher. Set it low and the budget runs out mid-session: at 100 a day,
# a morning of testing exhausted it and claims that a fact-checker had already
# settled abstained instead, correctly reporting the check as skipped.
# FACTIFY_FACTCHECK__DAILY_CAP=1000

# GOOGLE CLOUD VISION — images:annotate with WEB_DETECTION.
# A different product from Gemini: needs a Google Cloud project with billing enabled
# even to use the free tier. ~1,000 units/month free; the cap below sits under that
# on purpose so we degrade before the provider does.
#
# This is the only path to media older than the corpus, so the flagship case — a real
# 2019 photograph presented as today's event — cannot resolve without it.
# FACTIFY_VISION__ENABLED=false
# FACTIFY_VISION__API_KEY=
# FACTIFY_VISION__ENDPOINT=https://vision.googleapis.com/v1/images:annotate
# FACTIFY_VISION__DAILY_CAP=30

# AI-GENERATED AND FACE-SWAP DETECTOR — Sightengine (models genai + deepfake).
# Its readings are advisories: shown beside a picture as "a detector's estimate",
# never an input to a verdict. Free plan: 2,000 operations/month; one picture costs
# about 10 (genai 5 + deepfake). Sightengine gives an API user and an API secret:
# the user goes in ACCOUNT, the secret in API_KEY. The picture is sent to them to be
# read, as it is to the model that reads its text.
# FACTIFY_SYNTHETIC__ENABLED=false
# FACTIFY_SYNTHETIC__ACCOUNT=
# FACTIFY_SYNTHETIC__API_KEY=
# FACTIFY_SYNTHETIC__ENDPOINT=https://api.sightengine.com/1.0/check.json
# FACTIFY_SYNTHETIC__DAILY_CAP=60

# ARCHIVE CAPTURE — NOT a Google product, and not yet wired to anything.
#
# The intended provider is the Wayback Machine (archive.org), whose availability API
# needs no key at all. These settings are a placeholder for M31's archive
# confirmation, which is P1: it is additive, no gate depends on it, and the flagship
# case was deliberately built to resolve from matched-page dates without it.
#
# Leave unset. Nothing reads them today.
# FACTIFY_ARCHIVE__ENABLED=false
# FACTIFY_ARCHIVE__API_KEY=
# FACTIFY_ARCHIVE__DAILY_CAP=50

# --- Limits ------------------------------------------------------------------
# Enforced before any decode or parse (M10).
# FACTIFY_LIMITS__MAX_UPLOAD_BYTES=26214400
# FACTIFY_LIMITS__MAX_PDF_PAGES=50
# FACTIFY_LIMITS__MAX_VIDEO_SECONDS=90
# FACTIFY_LIMITS__MAX_VIDEO_KEYFRAMES=12
# FACTIFY_LIMITS__RAW_MEDIA_RETENTION_HOURS=24
